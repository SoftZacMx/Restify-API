meta {
  name: Mercado Pago Webhook
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/payments/webhooks/mercado-pago
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "action": "payment.updated",
    "api_version": "v1",
    "data": { "id": "123456789" },
    "date_created": "2026-05-10T12:00:00.000-04:00",
    "id": 1,
    "live_mode": false,
    "type": "payment",
    "user_id": "3296134323"
  }
}

settings {
  encodeUrl: true
}

docs {
  Endpoint público (sin autenticación) que recibe los webhooks de Mercado Pago. La validación de firma está deshabilitada (bug conocido del lado de MP). Usado para confirmar pagos QR.
}
