meta {
  name: Pay With QR Mercado Pago
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/payments/qr-mercado-pago
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "orderId": "{{orderId}}",
    "userId": "{{userId}}",
    "connectionId": null
  }
}

settings {
  encodeUrl: true
}

docs {
  Crea una sesión de pago QR con Mercado Pago. La sesión expira en 5 minutos. connectionId es opcional (WebSocket para notificación en vivo).
}
