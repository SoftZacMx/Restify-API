meta {
  name: Recover Password
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/recover-password/:user_id
  body: json
  auth: inherit
}

params:path {
  user_id: 
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "password": "NuevaPass123."
  }
}

settings {
  encodeUrl: true
}

docs {
  Flujo de recuperación sin sesión: el frontend primero verifica el email con /verify-user (obtiene user_id) y luego llama acá para setear la nueva contraseña. Rate-limited.
}
