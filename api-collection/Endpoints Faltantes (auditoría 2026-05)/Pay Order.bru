meta {
  name: Pay Order
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/orders/:order_id/pay
  body: json
  auth: inherit
}

params:path {
  order_id: 
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "method": "CASH",
    "amount": 100,
    "tip": 0
  }
}

settings {
  encodeUrl: true
}

docs {
  Procesa el cobro de una orden. Acepta pago único o split (ver payOrderSchema en payment.dto.ts: union entre payOrderSplitPayload y payOrderSinglePayload).
}
