meta {
  name: Get Menu Item
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/menu-items/:menu_item_id
  body: none
  auth: inherit
}

params:path {
  menu_item_id: {{menu_item_id}}
}

headers {
  Content-Type: application/json
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  GET /api/menu-items/:menu_item_id Get menu item by ID endpoint
}
