meta {
  name: Disable Branch
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/branches/{{branchId}}/disable
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
}

docs {
  Deshabilita una sucursal. La sucursal deshabilitada no aparecerá en listados activos ni permitirá operaciones. Requiere rol OWNER o ADMIN.
}
