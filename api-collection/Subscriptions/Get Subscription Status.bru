meta {
  name: Get Subscription Status
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/subscription/status
  body: none
  auth: bearer
}

headers {
  Authorization: Bearer {{token}}
}

auth:bearer {
  token: {{login-token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Devuelve el estado de la suscripción: exists, status, isActive, daysRemaining, cancelAtPeriodEnd y plan info. Requiere auth ADMIN.
}
