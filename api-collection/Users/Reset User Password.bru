meta {
  name: Reset User Password
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/users/:user_id/reset-password
  body: none
  auth: inherit
}

params:path {
  user_id: 2da6d5a1-5b98-44b3-bcd9-929eb9ccea0b
}

headers {
  Content-Type: application/json
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  POST /api/users/:user_id/reset-password — El owner/admin fuerza el reseteo de contraseña de un empleado de su org.
  
  No envía contraseña nueva: marca mustChangePassword=true (el empleado define su clave en el próximo login) e incrementa tokenVersion (cierra sus sesiones). Solo OWNER/ADMIN. Empleado de otra org → 404.
}
