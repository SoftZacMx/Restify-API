meta {
  name: Confirm Stripe Payment
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/payments/stripe/confirm
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "paymentIntentId": "pi_xxxxxxxx",
    "status": "succeeded"
  }
}

settings {
  encodeUrl: true
}

docs {
  POST /api/payments/stripe/confirm — Confirma el resultado de un pago Stripe. status: succeeded | failed.
}
