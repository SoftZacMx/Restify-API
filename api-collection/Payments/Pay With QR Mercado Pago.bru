meta {
  name: Pay With QR Mercado Pago
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/payments/qr-mercado-pago
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "orderId": "{{orderId}}",
    "userId": "{{userId}}",
    "connectionId": null
  }
}

settings {
  encodeUrl: true
}

docs {
  POST /api/payments/qr-mercado-pago — Genera una sesión de pago QR de Mercado Pago. La sesión expira en 5 minutos.
}
