{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Ciclo de vida de la suscripción",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "main",
      "label": "Camino normal"
    },
    {
      "id": "riesgo",
      "label": "Cobro fallido"
    },
    {
      "id": "terminal",
      "label": "Sin acceso"
    }
  ],
  "states": [
    {
      "id": "trialing",
      "type": "start",
      "label": "TRIALING",
      "sublabel": "nace en signup",
      "lane": "main",
      "col": 0,
      "step": "01"
    },
    {
      "id": "checkout",
      "type": "waiting",
      "label": "Checkout",
      "sublabel": "Stripe Session",
      "lane": "main",
      "col": 1,
      "step": "02"
    },
    {
      "id": "payment",
      "type": "decision",
      "label": "Pago",
      "sublabel": "webhook o verify",
      "lane": "main",
      "col": 2,
      "step": "03"
    },
    {
      "id": "active",
      "type": "success",
      "label": "ACTIVE",
      "sublabel": "acceso completo",
      "lane": "main",
      "col": 3,
      "step": "04"
    },
    {
      "id": "canceling",
      "type": "waiting",
      "label": "Cancelando",
      "sublabel": "cancelAtPeriodEnd",
      "lane": "main",
      "col": 4,
      "step": "05"
    },
    {
      "id": "past_due",
      "type": "failure",
      "label": "PAST_DUE",
      "sublabel": "3 días de gracia",
      "lane": "riesgo",
      "col": 1
    },
    {
      "id": "expired",
      "type": "failure",
      "label": "Vencida",
      "sublabel": "403 EXPIRED",
      "lane": "terminal",
      "col": 0
    },
    {
      "id": "canceled",
      "type": "failure",
      "label": "CANCELED",
      "sublabel": "sin acceso",
      "lane": "terminal",
      "col": 2
    }
  ],
  "transitions": [
    {
      "id": "no-payment",
      "from": "payment",
      "to": "expired",
      "label": "sin pago",
      "variant": "security",
      "route": "straight",
      "fromSide": "bottom",
      "toSide": "top",
      "labelDy": 24
    },
    {
      "id": "payment-failed",
      "from": "active",
      "to": "past_due",
      "label": "payment_failed",
      "variant": "security",
      "labelAt": [
        498,
        233
      ]
    },
    {
      "id": "payment-recovered",
      "from": "past_due",
      "to": "active",
      "label": "invoice.paid",
      "variant": "emphasis",
      "labelAt": [
        614,
        233
      ]
    },
    {
      "id": "grace-ended",
      "from": "past_due",
      "to": "expired",
      "label": "termina gracia",
      "variant": "security"
    },
    {
      "id": "subscription-deleted",
      "from": "canceling",
      "to": "canceled",
      "label": "deleted",
      "variant": "security",
      "route": "straight",
      "fromSide": "bottom",
      "toSide": "top",
      "labelDy": 24
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Camino normal",
      "items": [
        "Todo signup nace TRIALING; sin billing nace ACTIVE por 3 años",
        "OWNER o ADMIN paga cuando quiere; el webhook o verify lo deja ACTIVE",
        "Cada invoice.paid renueva el período"
      ]
    },
    {
      "dot": "amber",
      "title": "Cancelación",
      "items": [
        "Con Stripe: sigue ACTIVE hasta fin de período y se puede reactivar",
        "En trial (sin Stripe): pasa a CANCELED al instante"
      ]
    },
    {
      "dot": "rose",
      "title": "Control de acceso",
      "items": [
        "Pasa con ACTIVE/TRIALING vigente o PAST_DUE en gracia",
        "Si no: 403 SUBSCRIPTION_EXPIRED o SUBSCRIPTION_REQUIRED"
      ]
    }
  ]
}
