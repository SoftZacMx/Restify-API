// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// User Entity
model User {
  id               String   @id @default(uuid())
  name             String
  last_name        String
  second_last_name String?
  email            String   @unique
  password         String
  phone            String?
  status           Boolean  @default(true)
  rol              UserRole
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  orders         Order[]
  products       Product[]
  payments       Payment[]
  salaryPayments EmployeeSalaryPayment[]
  tables         Table[]
  menuItems      MenuItem[]
  expenses       Expense[]
  stockMovements StockMovement[]

  @@index([email])
  @@index([rol])
  @@index([status])
  @@map("users")
}

// Product Entity
model Product {
  id               String         @id @default(uuid())
  name             String
  description      String?
  registrationDate DateTime       @default(now())
  status           Boolean        @default(true)
  userId           String
  // Stock management (Nivel 3)
  stockActual      Decimal        @default(0) @db.Decimal(12, 3)
  unitOfMeasure    UnitOfMeasure?
  trackStock       Boolean        @default(false)
  minStockAlert    Decimal?       @db.Decimal(12, 3)
  averageCost      Decimal        @default(0) @db.Decimal(12, 4)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Relations
  user                User                 @relation(fields: [userId], references: [id])
  orderItems          OrderItem[]
  expenseItems        ExpenseItem[]
  menuItemIngredients MenuItemIngredient[]
  directMenuItems     MenuItem[]           @relation("MenuItemDirectProduct")
  stockMovements      StockMovement[]

  @@index([userId])
  @@index([status])
  @@index([trackStock])
  @@map("products")
}

// Order Entity
model Order {
  id              String    @id @default(uuid())
  date            DateTime  @default(now())
  status          Boolean   @default(false)
  paymentMethod   Int? // NULL for split payments, 1: Cash, 2: Transfer, 3: Card, 4: QR Mercado Pago
  total           Decimal   @db.Decimal(10, 2)
  subtotal        Decimal   @db.Decimal(10, 2)
  iva             Decimal   @default(0) @db.Decimal(10, 2)
  delivered       Boolean   @default(false)
  tableId         String? // Relation to Table
  tip             Decimal   @default(0) @db.Decimal(10, 2)
  origin          String // 'Local', 'Delivery', 'Order', etc.
  client          String?
  paymentDiffer   Boolean   @default(false)
  note            String?
  userId          String?
  customerName    String? // Nombre del cliente (pedidos online)
  customerPhone   String? // Teléfono del cliente (pedidos online)
  latitude        Float? // Coordenadas para domicilio
  longitude       Float? // Coordenadas para domicilio
  deliveryAddress String?   @db.Text // Dirección de referencia
  scheduledAt     DateTime? // Hora programada de entrega/recolección
  trackingToken   String?   @unique // Token UUID para seguimiento público
  deliveryStatus  String? // PENDING_PAYMENT, PAID, PREPARING, READY, ON_THE_WAY, DELIVERED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user                   User?                   @relation(fields: [userId], references: [id])
  table                  Table?                  @relation(fields: [tableId], references: [id])
  orderItems             OrderItem[]
  orderItemExtras        OrderItemExtra[]
  payments               Payment[]
  paymentDifferentiation PaymentDifferentiation?

  @@index([userId])
  @@index([tableId])
  @@index([date])
  @@index([status])
  @@index([paymentMethod])
  @@index([origin])
  @@map("orders")
}

// Order Item Entity
model OrderItem {
  id         String   @id @default(uuid())
  quantity   Int
  price      Decimal  @db.Decimal(10, 2)
  orderId    String
  productId  String?
  menuItemId String?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  order          Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product?         @relation(fields: [productId], references: [id])
  menuItem       MenuItem?        @relation(fields: [menuItemId], references: [id])
  extras         OrderItemExtra[]
  stockMovements StockMovement[]

  @@index([orderId])
  @@index([productId])
  @@index([menuItemId])
  @@map("order_items")
}

// Order Item Extra Entity (Extras associated with order items)
model OrderItemExtra {
  id          String   @id @default(uuid())
  orderId     String
  orderItemId String
  extraId     String // MenuItem with isExtra: true
  quantity    Int      @default(1)
  price       Decimal  @db.Decimal(10, 2) // Price snapshot at order time
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  extra     MenuItem  @relation(fields: [extraId], references: [id])

  @@index([orderId])
  @@index([orderItemId])
  @@index([extraId])
  @@map("order_item_extras")
}

// Payment Entity
model Payment {
  id                   String          @id @default(uuid())
  orderId              String?
  userId               String?
  amount               Decimal         @db.Decimal(10, 2)
  currency             String          @default("USD")
  status               PaymentStatus
  paymentMethod        PaymentMethod
  gateway              PaymentGateway? // NULL for CASH, TRANSFER, CARD_PHYSICAL
  gatewayTransactionId String?
  metadata             Json?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  // Relations
  order          Order?          @relation(fields: [orderId], references: [id])
  user           User?           @relation(fields: [userId], references: [id])
  refunds        Refund[]
  paymentSession PaymentSession?

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([gatewayTransactionId])
  @@map("payments")
}

// Payment Session Entity
model PaymentSession {
  id           String   @id @default(uuid())
  paymentId    String   @unique
  clientSecret String
  connectionId String? // WebSocket connection
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  // Relations
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_sessions")
}

// Payment Differentiation (Split Payments)
model PaymentDifferentiation {
  id                  String        @id @default(uuid())
  orderId             String        @unique
  firstPaymentAmount  Decimal       @db.Decimal(10, 2)
  firstPaymentMethod  PaymentMethod // CASH, TRANSFER, or CARD_PHYSICAL only
  secondPaymentAmount Decimal       @db.Decimal(10, 2)
  secondPaymentMethod PaymentMethod // CASH, TRANSFER, or CARD_PHYSICAL only
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments_differentiations")
}

// Refund Entity
model Refund {
  id              String       @id @default(uuid())
  paymentId       String
  amount          Decimal      @db.Decimal(10, 2)
  reason          String?
  gatewayRefundId String?
  status          RefundStatus
  createdAt       DateTime     @default(now())

  // Relations
  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("refunds")
}

// Employee Salary Payment Entity
model EmployeeSalaryPayment {
  id            String   @id @default(uuid())
  userId        String
  amount        Decimal  @db.Decimal(10, 2)
  paymentMethod Int // 1: Cash, 2: Transfer, 3: Card
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([date])
  @@map("employee_salaries_payments")
}

// Company Entity (singleton: one row per tenant/app - business info)
model Company {
  id              String   @id @default(uuid())
  name            String
  state           String
  city            String
  street          String
  exteriorNumber  String
  phone           String
  rfc             String?
  logoUrl         String?
  startOperations String? // Hora inicio operaciones "HH:mm"
  endOperations   String? // Hora fin operaciones "HH:mm"
  ticketConfig    Json? // Config tickets térmicos (JSON)
  paymentConfig   String?  @db.Text // JSON encriptado con AES-256-GCM (credenciales MP)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("companies")
}

// Table Entity (Restaurant Tables)
model Table {
  id                 String   @id @default(uuid())
  name               String   @unique @db.VarChar(64)
  userId             String
  status             Boolean  @default(true)
  availabilityStatus Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  user   User    @relation(fields: [userId], references: [id])
  orders Order[]

  @@index([userId])
  @@index([status])
  @@index([availabilityStatus])
  @@map("tables")
}

// Menu Category Entity (Categories for menu items)
model MenuCategory {
  id        String   @id @default(uuid())
  name      String
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  menuItems MenuItem[]

  @@index([status])
  @@map("menu_categories")
}

// Menu Item Entity (Dishes/Menu Items - previously "saources")
model MenuItem {
  id         String   @id @default(uuid())
  name       String
  price      Decimal  @db.Decimal(10, 2)
  status     Boolean  @default(true)
  isExtra    Boolean  @default(false) // Flag to identify extras
  categoryId String? // Optional - menu item can exist without a category
  userId     String
  // Stock management: vínculo opcional a un Product cuando es item directo
  // (1:1 con un producto del inventario, ej. una botella). Mutuamente exclusivo
  // con tener filas en menu_item_ingredients (validado a nivel servicio).
  productId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  category        MenuCategory?        @relation(fields: [categoryId], references: [id])
  user            User                 @relation(fields: [userId], references: [id])
  orderItems      OrderItem[]
  orderItemExtras OrderItemExtra[]
  product         Product?             @relation("MenuItemDirectProduct", fields: [productId], references: [id])
  ingredients     MenuItemIngredient[]

  @@index([categoryId])
  @@index([userId])
  @@index([status])
  @@index([isExtra])
  @@index([productId])
  @@map("menu_items")
}

// Recipe entries: cada fila representa "el MenuItem X consume cantidad N
// del Product Y por unidad vendida".
model MenuItemIngredient {
  id         String         @id @default(uuid())
  menuItemId String
  productId  String
  quantity   Decimal        @db.Decimal(12, 3)
  // Si null, se interpreta en la unidad del producto. Si difiere, el StockService convierte
  // al unit base del producto antes de descontar (ej. receta en G, producto en KG).
  unit       UnitOfMeasure?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([menuItemId, productId])
  @@index([menuItemId])
  @@index([productId])
  @@map("menu_item_ingredients")
}

// Stock movement ledger: cada operación que afecta stock crea una fila inmutable.
// Invariante: products.stockActual = sum(stock_movements.quantity WHERE productId=X).
model StockMovement {
  id            String            @id @default(uuid())
  productId     String
  quantity      Decimal           @db.Decimal(12, 3) // firmado: + entrada, - salida
  type          StockMovementType
  reason        String?           @db.VarChar(120)
  notes         String?           @db.Text
  expenseItemId String? // origen para PURCHASE
  orderItemId   String? // origen para SALE / SALE_REVERSAL
  userId        String? // null para movements originados por el sistema (ej. ventas de órdenes públicas)
  createdAt     DateTime          @default(now())

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  expenseItem ExpenseItem? @relation(fields: [expenseItemId], references: [id], onDelete: SetNull)
  orderItem   OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  user        User?        @relation(fields: [userId], references: [id])

  @@index([productId, createdAt])
  @@index([type, createdAt])
  @@index([expenseItemId])
  @@index([orderItemId])
  @@index([userId])
  @@map("stock_movements")
}

// Expense Entity (Unified expenses module - replaces PurchaseMerchandise and BusinessServicePayment)
model Expense {
  id            String      @id @default(uuid())
  title         String // Título obligatorio del gasto (máx. 200 caracteres)
  type          ExpenseType
  date          DateTime    @default(now())
  total         Decimal     @db.Decimal(10, 2)
  subtotal      Decimal     @db.Decimal(10, 2)
  iva           Decimal     @default(0) @db.Decimal(10, 2)
  description   String?
  paymentMethod Int // 1: Cash, 2: Transfer, 3: Card, 4: QR Mercado Pago
  userId        String? // Null para gastos creados por el sistema (ej. comisiones MP)
  paymentId     String? // Vínculo opcional al Payment del que se derivó (ej. comisión MP). Habilita idempotencia y auditoría.
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  user  User?         @relation(fields: [userId], references: [id])
  items ExpenseItem[] // Only populated when type = MERCHANDISE

  @@index([userId])
  @@index([date])
  @@index([type])
  @@index([paymentId])
  @@map("expenses")
}

// Expense Item Entity (Products in merchandise purchases - only for MERCHANDISE type)
model ExpenseItem {
  id            String         @id @default(uuid())
  expenseId     String
  productId     String
  amount        Decimal        @db.Decimal(10, 2)
  subtotal      Decimal        @db.Decimal(10, 2)
  total         Decimal        @db.Decimal(10, 2)
  unitOfMeasure UnitOfMeasure?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  expense        Expense         @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id])
  stockMovements StockMovement[]

  @@index([expenseId])
  @@index([productId])
  @@map("expense_items")
}

// Enums
enum UserRole {
  ADMIN
  MANAGER
  WAITER
  CHEF
}

enum PaymentStatus {
  PENDING
  PROCESSING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH // Efectivo
  TRANSFER // Transferencia bancaria
  CARD_PHYSICAL // Tarjeta física (POS local)
  CARD_STRIPE // Tarjeta vía Stripe (online)
  QR_MERCADO_PAGO // QR vía Mercado Pago
}

enum PaymentGateway {
  STRIPE
  PAYPAL
  CASH
  MERCADO_PAGO
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
}

enum ExpenseType {
  SERVICE_BUSINESS // Servicios del negocio (limpieza, seguridad, etc.)
  UTILITY // Servicios públicos (luz, agua, internet)
  RENT // Renta
  MERCHANDISE // Compra de mercancía (con items de productos)
  SALARY // Pago de salarios (empleado + monto)
  OTHER // Otros gastos
  MERCADO_PAGO_FEE // Comisión cobrada por Mercado Pago al confirmar un pago
}

enum SubscriptionStatus {
  ACTIVE // Suscripción activa, pago al día
  PAST_DUE // Pago falló, en período de gracia
  CANCELED // Cancelada por el usuario
  EXPIRED // Venció sin renovación
  TRIALING // En período de prueba (opcional)
}

enum BillingPeriod {
  MONTHLY
  ANNUAL
}

model SubscriptionPlan {
  id            String        @id @default(uuid())
  name          String // "Mensual", "Anual"
  billingPeriod BillingPeriod // MONTHLY, ANNUAL
  price         Int // Precio en centavos MXN (322000, 3112300)
  stripePriceId String        @unique
  status        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plans")
}

// Subscription Entity (una por base de datos = un negocio = una suscripción)
model Subscription {
  id                   String             @id @default(uuid())
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(EXPIRED)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  planId               String?
  plan                 SubscriptionPlan?  @relation(fields: [planId], references: [id])
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("subscriptions")
}

// Unidades de medida para inventario y compras de mercancía.
enum UnitOfMeasure {
  KG // Kilogramos
  G // Gramos
  L // Litros
  ML // Mililitros
  PCS // Piezas
  OTHER // Otros
}

// Tipo de movimiento en el ledger de stock.
enum StockMovementType {
  PURCHASE // Entrada por compra registrada en Expense MERCHANDISE
  SALE // Salida por venta de un MenuItem (item directo o vía receta)
  WASTE // Salida por merma manual (vencido, roto, robo, etc.)
  ADJUSTMENT // Diferencia por conteo físico u otros ajustes manuales
  SALE_REVERSAL // Reversal de una venta cancelada o item eliminado
}
